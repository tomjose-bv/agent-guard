# Copy to .env (never commit .env). Only needed for the optional LLM demo
# (examples/llm_agent.py). agent-guard itself needs no secrets.

# Any OpenAI-compatible chat completions endpoint.
AGENT_GUARD_LLM_BASE_URL=http://localhost:11434/v1
AGENT_GUARD_LLM_MODEL=llama3.1
# AGENT_GUARD_LLM_API_KEY=

# Optional: override the agent identity a proxy instance reports
# (otherwise `agent_id` from agent-guard.yaml is used).
# AGENT_GUARD_AGENT_ID=demo-agent
